#!/usr/bin/env bash
# Action entrypoint: opens the picker pane declared in the manifest.
# --agents opens it in agent view (via env — the pane's command is fixed).
extra=()
[ "${1:-}" = "--agents" ] && extra=(--env SESSIONIZER_MODE=agents)
exec "${HERDR_BIN_PATH:-herdr}" plugin pane open --plugin sessionizer --entrypoint picker ${extra[@]+"${extra[@]}"}
